# Neon Postgres (Marketplace). Pull locally with: vercel env pull .env.local --yes
DATABASE_URL=

# Vercel Blob. Created with `vercel blob store add` (or Marketplace) and injected into the project.
BLOB_READ_WRITE_TOKEN=

# Server-only admin authentication. Never prefix these with NEXT_PUBLIC_.
# ADMIN_PASSWORD_HASH format: scrypt:<base64url salt>:<base64url hash>
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional separate HMAC secret for one-way rate-limit identifiers.
# Falls back to ADMIN_SESSION_SECRET when omitted.
RATE_LIMIT_SECRET=
